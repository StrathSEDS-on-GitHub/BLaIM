  "db_name": "PostgreSQL",
  "query": "SELECT i.id, i.name, i.strid, m.present, (SELECT to_user FROM borrow WHERE item_id = i.id ORDER BY ordering DESC LIMIT 1) AS owner\n                FROM meta m\n                JOIN items i ON m.child = i.id\n                WHERE m.parent = $1",
